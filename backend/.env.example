PORT=3000
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=24h

DB_SERVER=localhost
DB_PORT=1433
DB_NAME=SDO_OA
# Windows 身份验证（推荐本机开发，无需 sa 密码）
DB_USE_WINDOWS_AUTH=true
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# SQL 身份验证（生产或远程库时使用）
# DB_USE_WINDOWS_AUTH=false
# DB_USER=sa
# DB_PASSWORD=YourPassword123
